<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:padding="24dp">

<TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Затемнятор экрана" android:textSize="24sp" android:textStyle="bold" android:paddingBottom="24dp" />

<SeekBar android:id="@+id/seekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="80" android:progress="30" />

<TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Затемнение: 30%" android:textSize="16sp" android:paddingTop="16dp" android:paddingBottom="32dp" />

<Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Включить затемнение"/>

<Button android:id="@+id/btnStop" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Выключить"/>

<Space
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:textSize="12sp"
    android:textColor="#888888"
    android:lineSpacingExtra="2dp"
    android:text="Затемняет экран поверх других приложений. Полезно для старых телефонов, где яркость высокая даже на минимуме. Пользуйтесь в удовольствие!" />
</LinearLayout>
